body { background: #fff; padding: 0; margin: 0; font: normal 13px arial, san-serif; color: #000; text-align: center; width: 100%; }
img { border: none; }
a { text-decoration: none; font: bold 13px arial, san-serif; color: #FF6600; }
a:hover { background-color:#FF6600; color:#fff; }
a.rollover {display: block;}
a.rollover:hover img { visibility: hidden; }	


#container { width: 100%; height: 876px; position: relative; top: 0px; margin: 0 auto; text-align: left; border: solid 1px blue;}

#mainMenu { width : 100%; height: auto; position: relative; top: 0px; margin: 0 auto; text-align: left; border-bottom: solid 1px blue; padding: 10px 0px 10px 0px;}
#mainMenu .mainMenu_item { display: inline; padding-left: 10px; }

#footer { width: 100%; height: auto; position: absolute; bottom: 0px; text-align: center; float: middle; padding: 10px 0px 10px 0px;} 
#footer .footer_item { display: inline; padding-left: 10px;}

#register_div {position: relative; width: 100%; height: auto; top:10px;}


#register_div .page_title {position: relative; left: 15px; top: 10px; font: bold 16px arial, san-serif; color: #000000;}
#register_div form {position: relative; width: 100%; height: auto; top: 30px; padding-left: 35px; }
#register_div .register_item {position: relative; width: 100%; height: auto; padding-bottom: 15px;}
#register_div .register_item .label {position: relative; width: 100px; text-align: right; padding-right: 10px;}
#register_div .register_item input { position: absolute; width: 200px; left: 120px; text-align: left; top: 0px;}
#register_div .register_item .button { width: 100px; padding-left: 10px; }

#header { width: 1000px; height: 82px; position: relative; left: 0px; top: 0px; }
#header #title { position: absolute; left: 0px; top: 0px; width:1000px; height: 75px; }
#header #title #cobrand {position: absolute; left: 27px; top: 6px; width: 150px; height: 30px; background: url(../images/placeholder_cobrand.gif) no-repeat; }
#header #title #cobrand2 {position: absolute; left: 27px; top: 21px; width: 59px; height: 21px; }
#header #title #logo {position: absolute; left: 885px; top: 7px; width: 87px; height: 41px; background:url(../images/text_logo.gif) no-repeat; }
#header #nav_bar { position: absolute; left: 0px; top: 42px; width:1000px; height: 21px;}
#header #nav_bar .mynetomat { position: absolute; left: 27px; top: 0px; width: 110px; height: 26px; background: url(../images/text_tab_mynetomat_over.gif) no-repeat; }
#header #nav_bar .addchannel { position: absolute; left: 139px; top: 0px; width: 119px; height: 26px; background: url(../images/text_tab_addchannel_over.gif) no-repeat; }
#header #nav_bar .channelsbyme { position: absolute; left: 260px; top: 0px; width: 128px; height: 26px; background: url(../images/text_tab_channelsbyme_over.gif) no-repeat; }
#header #nav_bar .contacts { position: absolute; left: 390px; top: 0px; width: 91px; height: 26px; background: url(../images/text_tab_contacts_over.gif) no-repeat; }
#header #nav_bar .recommendations { position: absolute; left: 483px; top: 0px; width: 142px; height: 26px; background: url(../images/text_tab_recommendations_over.gif) no-repeat; }
#header #nav_bar a.account { position: absolute; left: 804px; top: 11px; color: #fff; padding-left: 10px; padding-right: 10px; font: bold 11px arial, san-serif; border-right: dotted #9A9A9A 1px; }
#header #nav_bar a.help { position: absolute; left: 870px; top:11px; color: #fff; padding-left: 10px; padding-right: 10px; font: bold 11px arial, san-serif; border-left: solid #D1D1D0 1px; border-right: dotted #9A9A9A 1px; }
#header #nav_bar a.signout { position: absolute; left: 916px; top: 11px; color: #fff; padding-left: 10px; padding-right: 10px; font: bold 11px arial, san-serif; border-left: solid #D1D1D0 1px; }
#header #nav_bar a.account:hover { background-color:#fff; color:#C1C1C0; }
#header #nav_bar a.help:hover { background-color:#fff; color:#C1C1C0; }
#header #nav_bar a.signout:hover { background-color:#fff; color:#C1C1C0; }

#ad_banner { width: 1000px; height: 98px; position: relative; left: 0px; top: 0px; }
#ad_banner #ad {position: absolute; top: 4px; left: 101px; width: 728px; height: 90px; text-align: center;}
#header_realign {position: relative; left: 0px; top: 28px; margin-bottom: 28px; }



	

/* MY CHANNELS */	
#mychannels_content { position: relative; height: 650px; width: 1000px; }
#mychannels_content #page { position: absolute; left: 577px; top: 54px; width: 24px; height: 482; z-index: 2;} 
#mychannels_content #download_hat { position: absolute; left: 631px; top: 487px; width: 338px; height: 101px; border: solid #E5E5E5 1px; }
#mychannels_content #icons { position: relative; top: -2px; left: 2px; font: normal 10px arial, san-serif; color: #919191; } 
#mychannels_content #user_stats {position: absolute; left: 632px; top: 25px; width: 338px; height: 128px; }
#mychannels_content #mobile { position: absolute; left: 631px; top: 402px; width: 338px; height: 75px; }

#mychannels {position: absolute; left: 27px; top: 25px; width: 563px; height: 507px; border: solid #C1C3B1 1px; z-index: 1;}
#mychannels #drop_shadow {position: relative; left: 2px; top: 2px; width: 559px; height: 503px; background: #C1C3B1; border: solid #E6E6E6; 2px; z-index: -1;}
#mychannels #head {position: absolute; top: 1px; left: 1px; width: 561px; height: 20px; background: url(../images/bg_title_green.gif); }
#mychannels #head .title {position: relative; top: 1px; left: 5px; font: bold 14px arial, sans-serif; color:#4A4A4A; }
#mychannels #head a.sortby { position: relative; top: -12px; left: 506px; }
#mychannels #head a.sortby:hover { background-color:#FF6600; color:#fff; }
#mychannels #content {position: absolute; top: 21px; left: 0px; width: 563px; height: 486px; background-color: #F9FDE3;}
#mychannels #content #row {position: relative; top: 0px; left: 0px; width: 563px; height: 239px; border-top: solid #fff 1px; border-bottom: dotted #E2E5CF 1px;}
#mychannels #content #row .col1 {width: 171px; height: 241px; position: absolute; top: 0px; left: 18px; border-right: dotted #E2E5CF 1px;}
#mychannels #content #row .col2 {width: 175px; height: 241px; position: absolute; top: 0px; left: 190px; border-left: solid #fff 1px; border-right: dotted #E2E5CF 1px;}
#mychannels #content #row .col3 {width: 174px; height: 241px; position: absolute; top: 0px; left: 367px; border-left: solid #fff 1px; }
#mychannels #content #row #module { width: 175px; height: 241px; }
#mychannels #content #row #module .image_frame { width: 129px; height: 98px; position: absolute; left: 18px; top: 10px; background-color: #fff; border: solid #E2DFDF 1px; text-align: center; line-height:8em;}
#mychannels #content #row #module #text { position: absolute; left: 21px; top: 110px; width: 131px; height: 127px;  }
#mychannels #content #row #module #text .date { position: relative; left: -1px; top: 1px; font: normal 10px arial, san-serif; color: #919191; }
#mychannels #content #row #module #text .title { position: relative; left: 0px; top: 2px; font: bold 12px arial, san-serif; width: 119px; height: 18px; overflow: hidden; text-align: justify;}
#mychannels #content #row #module #text .title_unread { position: relative; left: 0px; top: 2px; font: bold 12px arial, san-serif; width: 119px; height: 18px; overflow: hidden;}
#mychannels #content #row #module #text .title_ellipses { position: relative; top: -14px; left: 119px; margin-bottom: -16px; font: normal 12px arial, san-serif; color: #FF6600;} 
#mychannels #content #row #module #text a.title:hover { background-color:#FF6600; color:#fff; }
#mychannels #content #row #module #text .bold { position: relative; left: 22px; top: -11px; font: bold 11px arial, san-serif; color: #000; }
#mychannels #content #row #module #text .user_icon { position: relative; top: 4px; left: 0px; } 
#mychannels #content #row #module #text .user_name { position: relative; top: -25px; left: 40px; width: 80px; overflow: hidden; text-overflow: ellipsis;} 
#mychannels #content #row #module #text .username_ellipses { position: relative; top: -40px; left: 119px; font: normal 12px arial, san-serif; color: #FF6600; margin-bottom: -32px; } 
#mychannels #content #row #module #text #blurb { position: relative; top: 0px; left: 0px; margin-top: -17px; margin-bottom: 8px; width: 119px; height: 25px; text-align: justify; overflow: hidden;} 
#mychannels #content #row #module #text .blurb_ellipses { position: relative; top: -20px; left: 119px; margin-bottom: -10px;} 

#mychannels #content #row #module #text #long_blurb { position: relative; top: 15px; left: 0px; margin-top: -17px; margin-bottom: 26px; width: 119px; height: 45px; text-align: justify; overflow: hidden;} 
#mychannels #content #row #module #text .long_blurb_ellipses { position: relative; top: -28px; left: 119px; margin-bottom: -20px;} 
#mychannels #content #row #module #text .entries { position: relative; top: -5px; left: -2px; font: normal 10px arial, san-serif; color: #919191; } 
#mychannels #content #row #module #text .subscribers { position: relative; top: -3px; left: -2px; font: normal 10px arial, san-serif; color: #919191; } 

.centerimage {display: table-cell; text-align: center; vertical-align: middle; width: 129px; height: 98px; background-color: #ffffff; }
.centerimage * {vertical-align: middle;}
/*\*//*/
.centerimage {display: block;}
.centerimage span {display: inline-block; height: 100%; width: 1px;}
.centerimage a {display: inline-block; height: 100%; width: 1px;}
/**/

.centerimage_border {display: table-cell; text-align: center; vertical-align: middle; width: 131px; height: 100px; background-color: #ffffff; border: solid #E2DFDF 1px; }
.centerimage_border * {vertical-align: middle;}
/*\*//*/
.centerimage_border {display: block;}
.centerimage_border span {display: inline-block; height: 100%; width: 1px;}
.centerimage_border a {display: inline-block; height: 100%; width: 1px;}
