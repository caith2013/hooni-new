#create_channel .bold {position: relative; left: 10px; top: 5px; font: bold 12px arial, san-serif; color: #4a4a4a;}
#create_channel .options_row {position: relative; left: 5px; top: 7px; height: 16px; font: 11px arial, san-serif; color: #000000;}
#create_channel .options_row .upload_images_radio {position: absolute; left: 2px; top: 2px;}
#create_channel .options_row .upload_text {position: absolute; left: 24px; top: 5px; color: #000000;}
