#waiting #image {position: absolute; left: 8px; top: 24px; }

#create_channel {position: absolute; left: 26px; top: 25px; width: 563px; height: 512px; z-index: 1;}
#create_channel #top {position: relative; left: 0; top: 0px; width: 563px; height: 25px; padding-bottom: 0px; border-bottom: dotted #D9D9D9 1px; font: bold 20px arial, sans-serif; color: #4a4a4a;}
