#createchannel_text_content { position: relative;  }

#greyout_trans { display:none; width: 100%; height: 100%; position: absolute; top: 0px; left: 0px; background-color: #ccc; filter:alpha(opacity=50); opacity: 0.5; -moz-opacity:0.5; }
#waiting {display:none; position: absolute; left: 303px; top: 253px; width: 320px; height: 50px; background-color: #fff; border-bottom: solid #949494 2px; border-right: solid #949494 2px; filter:alpha(opacity=100); opacity: 1; -moz-opacity:1;}
